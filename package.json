{
  "name": "thosaphol-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thosaphol Connect — digital twin platform for simulating ESP32, Arduino and Raspberry Pi circuits",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p . && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "form:setup": "tsx server/form-setup.ts setup",
    "form:test": "tsx server/form-setup.ts test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.44.2",
    "@lezer/highlight": "^1.2.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@uiw/react-codemirror": "^4.25.13",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "mqtt": "^5.16.1",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.19",
    "three-mesh-bvh": "^0.10.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
