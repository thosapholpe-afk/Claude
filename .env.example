# ---------------------------------------------------------------------------
# XTwin server configuration — copy to .env and fill in what you need.
# Everything is optional: with nothing set, XTwin runs in local/guest mode.
# ---------------------------------------------------------------------------

# Where the browser reaches the app (used for OAuth redirect URIs).
# Dev: Vite on 5173 proxies /auth and /api to the API server.
PUBLIC_URL=http://localhost:5173
PORT=8787
# Long random string; keeps people signed in across server restarts.
SESSION_SECRET=change-me-to-a-long-random-string

# Allow "Continue without an account" (true/false)
ALLOW_GUEST=true

# --- Sign-in providers ------------------------------------------------------
# Redirect URI to register with each provider: ${PUBLIC_URL}/auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram API with Instagram Login (works for Instagram professional accounts)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Google Form sign-up log -------------------------------------------------
# The form ID from https://docs.google.com/forms/d/e/<GFORM_ID>/viewform
GFORM_ID=
# Entry IDs from "Get pre-filled link" (numbers only, e.g. 123456789)
GFORM_ENTRY_NAME=
GFORM_ENTRY_EMAIL=
GFORM_ENTRY_PROVIDER=
GFORM_ENTRY_ROLE=
GFORM_ENTRY_ORG=
GFORM_ENTRY_EVENT=
GFORM_ENTRY_TIME=
# Also record every returning login / every guest name (true/false)
GFORM_LOG_LOGINS=false
GFORM_LOG_GUESTS=false

# --- AI copilot (Claude) -----------------------------------------------------
# Without a key the copilot falls back to the offline keyword assistant.
ANTHROPIC_API_KEY=
# Require sign-in before using the copilot (true/false)
AI_REQUIRE_LOGIN=false
AI_RATE_PER_MIN=40
